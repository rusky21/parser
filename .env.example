# ====================================================================
# LeadHunter Pro & FL.ru Parser Environment Configuration
# ====================================================================

# Токен вашего Telegram-бота (получите у @BotFather в Telegram)
# Пример: TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=

# Реверс-прокси Cloudflare Worker для обхода блокировок Telegram API без VPN
# Пример: TELEGRAM_API_SERVER=https://jolly-haze-c6cf.eprof6682-3e3.workers.dev
TELEGRAM_API_SERVER=

# Опционально: SOCKS5 / HTTP Прокси (если не используется Cloudflare Worker)
# TELEGRAM_PROXY=socks5://127.0.0.1:1080

# Хост и порт для запуска FastAPI бэкенда (по умолчанию 0.0.0.0:8000)
HOST=0.0.0.0
PORT=8000
